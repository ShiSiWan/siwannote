# ==============================================================================
# SiWan_notes (siwannote) - Environment Configuration Example
# ==============================================================================

# [Server & Network Settings]
SIWAN_HOST=0.0.0.0
SIWAN_PORT=8080
SIWAN_PATH_PREFIX=

# [Data & Storage Path]
# Path where Markdown documents and attachments are stored
SIWAN_PATH=/data

# [Docker Permissions]
PUID=0
PGID=0

# [Authentication & Security]
# Auth Type: none | read_only | password | totp
SIWAN_AUTH_TYPE=none

# Administrator Credentials (Used for admin dashboard, storage management, and AI config)
SIWAN_USERNAME=admin
SIWAN_PASSWORD=admin123

# JWT Secret Key for token signing
SIWAN_SECRET_KEY=siwan-secret-key-super-secure-2026

# Session duration in days
SIWAN_SESSION_EXPIRY_DAYS=30

# [Quick Access & Navigation Bar]
SIWAN_QUICK_ACCESS_HIDE=false
SIWAN_QUICK_ACCESS_TITLE=全部文档 (按名称排序)
SIWAN_QUICK_ACCESS_TERM=*
SIWAN_QUICK_ACCESS_SORT=title
SIWAN_QUICK_ACCESS_LIMIT=100
